<root main_tree_to_execute = "PlaceCupOnTable" BTCPP_format = "4">
  <BehaviorTree ID = "PlaceCupOnTable">
    <Sequence>
      <NavTo tolerance = "0.500000" y = "2.000000" x = "2.000000" robot_name = "CAR" message = "{nav_to_cup_msg}" success = "{nav_to_cup_success}"/>
      <Precondition else = "FAILURE" if = "nav_to_cup_success == true">
        <AlwaysSuccess/>
      </Precondition>
      <Pick object_name = "CUP" robot_name = "CAR" message = "{pick_msg}" success = "{pick_success}"/>
      <Precondition else = "FAILURE" if = "pick_success == true">
        <AlwaysSuccess/>
      </Precondition>
      <NavTo tolerance = "0.500000" y = "2.000000" x = "-2.000000" robot_name = "CAR" message = "{nav_to_table_msg}" success = "{nav_to_table_success}"/>
      <Precondition else = "FAILURE" if = "nav_to_table_success == true">
        <AlwaysSuccess/>
      </Precondition>
      <Place location_name = "TABLE" object_name = "CUP" robot_name = "CAR" message = "{place_msg}" success = "{place_success}"/>
      <Precondition else = "FAILURE" if = "place_success == true">
        <AlwaysSuccess/>
      </Precondition>
    </Sequence>
  </BehaviorTree>
</root>
